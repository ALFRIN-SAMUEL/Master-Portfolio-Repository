SELECT product, SUM(amount) AS total_sales
FROM orders
GROUP BY product;
SELECT customer_id, COUNT(*) AS total_orders
FROM orders
GROUP BY customer_id;
SELECT region, AVG(amount) AS average_order_amount
FROM orders
GROUP BY region;
SELECT category, SUM(quantity) AS total_quantity
FROM orders
GROUP BY category;
SELECT customer_id, MAX(amount) AS maximum_amount
FROM orders
GROUP BY customer_id;
SELECT category, COUNT(DISTINCT product) AS distinct_products
FROM orders
GROUP BY category;
SELECT DATE_FORMAT(order_date, '%Y-%m') AS order_month,
       COUNT(*) AS total_orders
FROM orders
GROUP BY DATE_FORMAT(order_date, '%Y-%m');
SELECT category, SUM(amount) AS total_sales
FROM orders
GROUP BY category
HAVING SUM(amount) > 50000;
SELECT customer_id, COUNT(*) AS total_orders
FROM orders
GROUP BY customer_id
HAVING COUNT(*) > 5;
SELECT region, SUM(amount) AS total_revenue
FROM orders
GROUP BY region
ORDER BY total_revenue DESC;
SELECT product, AVG(quantity) AS average_quantity
FROM orders
GROUP BY product
HAVING AVG(quantity) > 10;
SELECT region, category,
       COUNT(*) AS total_orders,
       SUM(amount) AS total_amount
FROM orders
GROUP BY region, category;
SELECT product,
       MIN(amount) AS minimum_amount,
       MAX(amount) AS maximum_amount
FROM orders
GROUP BY product;
SELECT category,
       COUNT(DISTINCT customer_id) AS distinct_customers
FROM orders
GROUP BY category
HAVING COUNT(DISTINCT customer_id) > 20;
SELECT region, SUM(amount) AS total_sales
FROM orders
GROUP BY region
ORDER BY total_sales DESC
LIMIT 3;
