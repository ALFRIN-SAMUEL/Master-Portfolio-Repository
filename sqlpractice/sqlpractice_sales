CREATE DATABASE sales_db;
USE sales_db;
CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    customer_id VARCHAR(10),
    product VARCHAR(50),
    category VARCHAR(30),
    amount DECIMAL(10,2),
    order_date DATE,
    region VARCHAR(20),
    quantity INT
);
